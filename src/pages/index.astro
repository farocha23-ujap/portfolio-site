---
import { site } from "../content/site";
import "../styles/global.css";

function isFilled(value: string): boolean {
  const v = (value || "").trim();
  if (!v) return false;
  if (v.includes("PLACEHOLDER")) return false;
  if (v === "DOCUGUARD_LIVE_URL") return false;
  if (v === "LINKEDIN_PLACEHOLDER") return false;
  if (v === "VIDEO_PLACEHOLDER") return false;
  if (!/^https?:\/\//i.test(v)) return false;
  return true;
}

const liveReady = isFilled(site.docuguardLiveUrl);
const linkedinReady = isFilled(site.linkedin);
const videoReady = isFilled(site.videoUrl);
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content={`${site.name} — ${site.role}. CV vivo: backend, IA, seguridad y proyectos públicos.`}
    />
    <title>{site.shortName} · CV</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Source+Sans+3:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <nav class="nav shell">
      <a href="#sobre-mi">Sobre mí</a>
      <a href="#experiencia">Experiencia</a>
      <a href="#docuguard">DocuGuard</a>
      <a href="#proyectos">Proyectos</a>
      <a href="#contacto">Contacto</a>
    </nav>

    <header class="hero shell">
      <p class="hero-role">{site.role}</p>
      <h1 class="hero-brand">{site.shortName}</h1>
      <p class="hero-sub">{site.subtitle}</p>
      <p class="hero-tag">{site.tagline}</p>
      <p class="hero-meta">{site.location}</p>
      <div class="cta-row">
        {
          liveReady ? (
            <a class="btn btn-primary" href={site.docuguardLiveUrl}>
              Live DocuGuard
            </a>
          ) : (
            <a class="btn btn-primary" href={site.featured.repo}>
              Ver DocuGuard
            </a>
          )
        }
        <a class="btn btn-ghost" href="#experiencia">Experiencia</a>
        <a class="btn btn-ghost" href={`mailto:${site.email}`}>Email</a>
      </div>
    </header>

    <section class="section shell" id="sobre-mi">
      <h2>Sobre mí</h2>
      {site.about.map((p) => <p class="about-p">{p}</p>)}
      <div class="soft-row">
        {site.softSkills.map((s) => <span class="soft-chip">{s}</span>)}
      </div>
    </section>

    <section class="section shell" id="experiencia">
      <h2>Experiencia</h2>
      {
        site.experience.map((job) => (
          <article class="job">
            <div class="job-top">
              <div>
                <h3>{job.title}</h3>
                <p class="job-org">{job.org}</p>
              </div>
              <span class="job-date">{job.dates}</span>
            </div>
            <ul>
              {job.bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </section>

    <section class="section shell" id="educacion">
      <h2>Educación</h2>
      {
        site.education.map((e) => (
          <div class="edu">
            <strong>{e.title}</strong>
            <span>
              {e.org} · {e.detail}
            </span>
          </div>
        ))
      }
    </section>

    <section class="section shell" id="docuguard">
      <h2>Proyecto estrella</h2>
      <p class="section-lead">
        Evidencia pública de RAG + ingeniería: el proyecto que debes abrir primero.
      </p>
      <article class="featured">
        <div>
          <h3>{site.featured.title}</h3>
          <p class="sub">{site.featured.subtitle}</p>
          <ul>
            {site.featured.bullets.map((b) => <li>{b}</li>)}
          </ul>
          <div class="cta-row">
            {
              liveReady ? (
                <a class="btn btn-primary" href={site.docuguardLiveUrl}>
                  Abrir demo
                </a>
              ) : null
            }
            <a class="btn btn-ghost" href={site.featured.repo}>Código</a>
            <a class="btn btn-ghost" href={site.featured.architecture}>Arquitectura</a>
            {
              videoReady ? (
                <a class="btn btn-ghost" href={site.videoUrl}>
                  Video
                </a>
              ) : null
            }
          </div>
        </div>
        <div class="visual" aria-hidden="true">
          <div>
            <strong>DocuGuard</strong>
            Políticas → retrieval → citas con score
            <br />
            recall@3 · stub sin API key
          </div>
        </div>
      </article>
    </section>

    <section class="section shell" id="proyectos">
      <h2>Portafolio público</h2>
      <p class="section-lead">
        Repos separados por fase. En LinkedIn/CV basta enlazar <strong>esta página</strong>.
      </p>
      <div class="grid grid-4">
        {
          site.projects.map((p) => (
            <article class="project">
              <div class="phase">{p.phase}</div>
              <h3>{p.title}</h3>
              <p>{p.blurb}</p>
              <a href={p.href}>Repositorio →</a>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section shell" id="stack">
      <h2>Stack técnico</h2>
      <div class="tech-grid">
        {
          site.techBlocks.map((t) => (
            <div class="tech-block">
              <strong>{t.title}</strong>
              <p>{t.body}</p>
            </div>
          ))
        }
      </div>
      <div class="stack" style="margin-top: 1.25rem">
        {site.stack.map((s) => <span>{s}</span>)}
      </div>
    </section>

    <section class="section shell contact" id="contacto">
      <h2>Contacto</h2>
      <p>
        Email: <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
      <p>Teléfono: {site.phone}</p>
      <p>
        GitHub (portafolio): <a href={site.github}>{site.githubUser}</a>
        {" · "}
        Personal: <a href={site.githubPersonal}>felixaroc-a</a>
      </p>
      <p>
        Hub técnico: <a href={site.hub}>portfolio-hub</a>
      </p>
      <p>
        LinkedIn:{" "}
        {
          linkedinReady ? (
            <a href={site.linkedin}>{site.linkedin}</a>
          ) : (
            <>
              <code>LINKEDIN_PLACEHOLDER</code>
              <span class="placeholder-warn"> ← edita site.ts</span>
            </>
          )
        }
      </p>
      <p class="langs">{site.languages.join(" · ")}</p>
    </section>

    <footer class="shell">
      © {new Date().getFullYear()} {site.name} · CV vivo · {site.location}
    </footer>
  </body>
</html>
